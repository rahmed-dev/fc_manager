# Dev credentials for bin/fcm-dev and the spike script.
# Copy to .env, fill in, then: chmod 600 .env
# .env is git-ignored. Prefer a dev API key that you can revoke.
# NEVER put real values in this file: it is committed to git.
FCM_API_KEY=
FCM_API_SECRET=
